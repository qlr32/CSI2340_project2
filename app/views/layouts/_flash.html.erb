<!-- app/views/layouts/_flash.html.erb -->
<% flash.each do |type, message| %>
  <div class="flash flash-<%= type %>">
    <%= message %>
  </div>
<% end %>

<style>
  .flash {
    padding: 15px 20px;
    margin: 20px auto;
    max-width: 1000px;
    border-radius: 5px;
    font-weight: 500;
  }
  .flash-notice {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
  .flash-alert {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
</style>