<!-- app/views/animals/index.html.erb -->
<div class="animals-index">
  <header class="page-header">
    <h1>Animal Shelter Intake System</h1>
    <p class="count"><%= pluralize(@animals.count, "animal") %> in our care</p>
  </header>

  <div class="actions">
    <%= link_to "Add New Animal", new_animal_path, class: "btn btn-primary" %>
  </div>

  <% if @animals.any? %>
    <div class="animals-list">
      <%= render @animals %>
    </div>
  <% else %>
    <p class="empty-state">No animals currently in the shelter.</p>
  <% end %>
</div>

<style>
  .animals-index { max-width: 1000px; margin: 0 auto; padding: 20px; }
  .page-header { text-align: center; margin-bottom: 30px; }
  .page-header h1 { color: #2c3e50; margin-bottom: 10px; }
  .count { color: #7f8c8d; font-size: 18px; }
  .actions { margin-bottom: 20px; }
  .btn { padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; }
  .btn-primary { background: #3498db; color: white; }
  .btn-primary:hover { background: #2980b9; }
  .animals-list { display: grid; gap: 15px; }
  .empty-state { text-align: center; padding: 40px; color: #95a5a6; }
</style>